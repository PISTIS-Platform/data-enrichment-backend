  <rdf:Description rdf:about="http://openenergy-platform.org/ontology/oeo/OEO_00000169">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://openenergy-platform.org/ontology/oeo/OEO_00000068"/>
