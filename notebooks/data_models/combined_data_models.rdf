  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000038">
    <ns4:IAO_0000116 xml:lang="en">BFO 2 Reference: A temporal interval is a special kind of one-dimensional temporal region, namely one that is self-connected (is without gaps or breaks).</ns4:IAO_0000116>
