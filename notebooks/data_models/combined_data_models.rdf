  <rdf:Description rdf:about="http://openenergy-platform.org/ontology/oeo/OEO_00010065">
    <rdfs:label xml:lang="en">KSG sector energy industry</rdfs:label>
    <ns1:OEO_00010467 rdf:resource="http://openenergy-platform.org/ontology/oeo/OEO_00010057"/>
    <ns1:OEO_00010467 rdf:resource="http://openenergy-platform.org/ontology/oeo/OEO_00010040"/>
