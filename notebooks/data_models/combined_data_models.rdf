  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000109">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
    <rdfs:isDefinedBy rdf:resource="http://openenergy-platform.org/ontology/oeo/imports/iao-extracted.owl"/>
    <ns4:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns4:IAO_0000119 xml:lang="en">OBI_0000305</ns4:IAO_0000119>
    <ns4:IAO_0000119 xml:lang="en">group:OBI</ns4:IAO_0000119>
    <ns4:IAO_0000111 xml:lang="en">measurement datum</ns4:IAO_0000111>
    <ns4:IAO_0000116 xml:lang="en">2/2/2009 is_specified_output of some assay?</ns4:IAO_0000116>
    <ns4:IAO_0000117 xml:lang="en">person:Chris Stoeckert</ns4:IAO_0000117>
    <ns4:IAO_0000112 xml:lang="en">Examples of measurement data are the recoding of the weight of a mouse as {40,mass,"grams"}, the recording of an observation of the behavior of the mouse {,process,"agitated"}, the recording of the expression level of a gene as measured through the process of microarray experiment {3.4,luminosity,}.</ns4:IAO_0000112>
    <rdfs:label xml:lang="en">measurement datum</rdfs:label>
    <ns4:IAO_0000115 xml:lang="en">A measurement datum is an information content entity that is a recording of the output of a measurement such as produced by a device.</ns4:IAO_0000115>
  </rdf:Description>
