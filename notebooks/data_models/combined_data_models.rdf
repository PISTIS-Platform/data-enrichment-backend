  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0002314">
    <ns4:IAO_0000116>Because part_of is transitive, inheres in is a sub-relation of characteristic of part of</ns4:IAO_0000116>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/ro/docs/reflexivity/"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002502"/>
    <ns4:IAO_0000119 rdf:resource="http://www.ncbi.nlm.nih.gov/pubmed/20064205"/>
    <rdfs:label xml:lang="en">characteristic of part of</rdfs:label>
    <ns4:IAO_0000115>q characteristic of part of w if and only if there exists some p such that q inheres in p and p part of w.</ns4:IAO_0000115>
    <ns4:IAO_0000118>inheres in part of</ns4:IAO_0000118>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <ns4:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
    <ns4:RO_0001900 rdf:resource="http://purl.obolibrary.org/obo/RO_0001901"/>
  </rdf:Description>
