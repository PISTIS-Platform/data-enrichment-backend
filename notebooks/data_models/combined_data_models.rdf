    <rdf:type rdf:resource="https://w3id.org/airm-o/ontology#CodeContaminationType"/>
    <rdfs:comment>Oil and gas.</rdfs:comment>
    <rdfs:label>OIL</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N9e97ee4125054ef7a81d3643b24c1b5f">
    <owl:annotatedTarget>"An energy unit which is equal to 1,000 watt-hours." [Wikipedia:Wikipedia]</owl:annotatedTarget>
