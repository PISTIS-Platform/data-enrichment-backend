    <ns4:IAO_0000118 xml:lang="de">chemische Substanz</ns4:IAO_0000118>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns4:IAO_0000115 xml:lang="en">A chemical substance is a portion of matter of constant composition and that is neither a metal or mineral. It is composed of molecular entities of the same type or of different types that is used in or produced by a chemical reaction involving changes to atoms or molecules. It is the physical output of an industrial process and has a commodity role.</ns4:IAO_0000115>
  </rdf:Description>
