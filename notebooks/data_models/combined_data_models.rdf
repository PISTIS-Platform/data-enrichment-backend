  <rdf:Description rdf:about="https://saref.etsi.org/saref4ener/RemainingPauseTime">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Remaining pause time</rdfs:label>
    <rdfs:comment xml:lang="en">The duration that the current slot (s4ee:activeSlotNumber) permits being paused. This element SHALL ONLY be present if the power sequence is interruptible. Otherwise, it SHALL be omitted. In case the power sequence is interruptible the following rules apply: If the element is absent this means there is no explicit pause duration restriction for the current slot; a value of 0s denoted the slot does not permit being paused.</rdfs:comment>
  </rdf:Description>
