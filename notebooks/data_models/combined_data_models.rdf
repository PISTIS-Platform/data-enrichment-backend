    <ns4:IAO_0000233 xml:lang="en">issue: https://github.com/OpenEnergyPlatform/ontology/issues/1052
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1078
rework module structure 
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1592
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1652</ns4:IAO_0000233>
    <ns4:IAO_0000115 xml:lang="en">A protected area is a two-dimensional spatial region recognised, dedicated and managed, through legal or other effective means, to achieve the long term conservation of nature with associated ecosystem services and cultural values.</ns4:IAO_0000115>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000009"/>
