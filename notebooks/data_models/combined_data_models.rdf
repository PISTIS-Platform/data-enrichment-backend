  <rdf:Description rdf:nodeID="Nc9b91eb2ca9f47a0a50e508d27913ef6">
    <owl:onProperty rdf:resource="http://openenergy-platform.org/ontology/oeo/OEO_00000532"/>
    <owl:someValuesFrom rdf:resource="http://openenergy-platform.org/ontology/oeo/OEO_00000115"/>
