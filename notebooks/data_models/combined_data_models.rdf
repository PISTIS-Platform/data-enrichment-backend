  <rdf:Description rdf:about="http://openenergy-platform.org/ontology/oeo/OEO_00010478">
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
    <rdfs:subPropertyOf rdf:resource="http://openenergy-platform.org/ontology/oeo/OEO_00010476"/>
    <ns4:IAO_0000115 xml:lang="en">A relation between a (composed) unit A and a unit B in which B is in the numerator of unit A with exponent 2.</ns4:IAO_0000115>
    <rdfs:label xml:lang="en">has squared unit denominator</rdfs:label>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:propertyDisjointWith rdf:resource="http://openenergy-platform.org/ontology/oeo/OEO_00010479"/>
    <ns4:IAO_0000233>issue: https://github.com/OpenEnergyPlatform/ontology/issues/1815
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1816</ns4:IAO_0000233>
    <ns4:IAO_0000600>A composed unit is composed of at least two other units. Examples are:
m/s has a linear numerator metre and a linear denominator second.
kg/m³ has a linear numerator kilogram and a cubed denominator metre.
Wh has two linear numerators: Watt and hour</ns4:IAO_0000600>
  </rdf:Description>
