  <rdf:Description rdf:about="http://openenergy-platform.org/ontology/oeo/OEO_00040008">
    <ns4:IAO_0000115>Marginal cost is the economic value that corresponds to the change in the total cost that arises when the quantity produced is incremented by one unit; that is, it is the cost of producing one more unit of a good.</ns4:IAO_0000115>
    <ns4:IAO_0000233>https://github.com/OpenEnergyPlatform/ontology/issues/376
https://github.com/OpenEnergyPlatform/ontology/pull/642</ns4:IAO_0000233>
    <rdfs:subClassOf rdf:resource="http://openenergy-platform.org/ontology/oeo/OEO_00140012"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">marginal cost</rdfs:label>
    <ns4:IAO_0000119>O'Sullivan, Arthur; Sheffrin, Steven M. (2003). Economics: Principles in Action.</ns4:IAO_0000119>
  </rdf:Description>
