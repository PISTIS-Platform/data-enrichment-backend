    <rdfs:range rdf:resource="https://w3id.org/airm-o/ontology#SignificantPoint"/>
    <rdfs:comment>A point defined by a latitude, longitude and MSL elevation used in conjunction with the LTP and the geometric center of the WGS-84 ellipsoid to define the vertical plane of a PA RNAV final approach course.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/airm-o/ontology#CodeVerticalStructureMaterialType-REINFORCED_CONCRETE">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/airm-o/ontology#CodeVerticalStructureMaterialType"/>
    <rdfs:comment>Poured concrete containing steel bars or metal netting to increase its tensile strength.</rdfs:comment>
