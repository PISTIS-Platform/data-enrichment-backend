    <rdf:type rdf:resource="https://w3id.org/airm-o/ontology#CodeATFMMeasureType"/>
    <rdfs:comment>A tactical ATFM measure expressed as the number of minutes required between successive aircraft or a tactical ATFM measure expressed as the number of miles required between aircraft (in addition to the minimum longitudinal requirements) to meet a specific criterion which may be separation, airport, fix, altitude, sector or route specific.</rdfs:comment>
    <rdfs:label>MILES_MINUTES_IN_TRAIL</rdfs:label>
  </rdf:Description>
