    <rdfs:label xml:lang="it">Ufficio postale</rdfs:label>
    <rdfs:label xml:lang="en">Postal office</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
