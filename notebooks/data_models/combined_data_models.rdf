    <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
    <ns4:IAO_0000115>"An electric potential difference unit which is equal to the work per unit charge. One volt is the potential difference required to move one coulomb of charge between two points in a circuit while using one joule of energy." [Wikipedia:Wikipedia]</ns4:IAO_0000115>
    <rdfs:label>volt</rdfs:label>
    <ns3:hasExactSynonym>V</ns3:hasExactSynonym>
