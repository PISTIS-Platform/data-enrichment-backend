  <rdf:Description rdf:about="http://openenergy-platform.org/ontology/oeo/OEO_00000255">
    <ns4:IAO_0000115 xml:lang="en">A grid component link is a grid component that serves as a connection between two other grid components.</ns4:IAO_0000115>
    <ns4:IAO_0000233 xml:lang="en">issue: https://github.com/OpenEnergyPlatform/ontology/issues/36
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/385

Move to oeo-shared:
https://github.com/OpenEnergyPlatform/ontology/pull/1360

rework module structure 
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1592
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1652</ns4:IAO_0000233>
    <owl:disjointWith rdf:resource="http://openenergy-platform.org/ontology/oeo/OEO_00000296"/>
    <rdfs:label xml:lang="en">grid component link</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://openenergy-platform.org/ontology/oeo/OEO_00020006"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N591a1ca8ac6f43dba63d53df90def81b">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
    <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000602"/>
    <owl:annotatedTarget>(forall (x) (if (Occurrent x) (exists (r) (and (SpatioTemporalRegion r) (occupiesSpatioTemporalRegion x r))))) // axiom label in BFO2 CLIF: [108-001] </owl:annotatedTarget>
    <ns4:IAO_0010000 rdf:resource="http://purl.obolibrary.org/obo/bfo/axiom/108-001"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2a5af133f6a440818d0f05d865089068">
    <owl:annotatedTarget>(iff (ZeroDimensionalContinuantFiatBoundary a) (and (ContinuantFiatBoundary a) (exists (b) (and (ZeroDimensionalSpatialRegion b) (forall (t) (locatedInAt a b t)))))) // axiom label in BFO2 CLIF: [031-001] </owl:annotatedTarget>
    <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/BFO_0000147"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000602"/>
    <ns4:IAO_0010000 rdf:resource="http://purl.obolibrary.org/obo/bfo/axiom/031-001"/>
  </rdf:Description>
