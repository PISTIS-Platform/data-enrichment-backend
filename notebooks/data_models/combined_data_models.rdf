  <rdf:Description rdf:about="http://w3id.org/um/cbcm/eu-cm-ontology#DomesticMergerIntoNewCompany">
    <rdfs:subClassOf rdf:nodeID="Nfe50f24564d64ced87ae9e9c6919e9d0"/>
