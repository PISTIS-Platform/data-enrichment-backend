  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0002230">
    <ns4:IAO_0000115>x ends with y if and only if x has part y and the time point at which x ends is equivalent to the time point at which y ends. Formally: α(y) &gt; α(x) ∧ ω(y) = ω(x), where α is a function that maps a process to a start point, and ω is a function that maps a process to an end point.</ns4:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <ns4:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
    <ns4:IAO_0000117>Chris Mungall</ns4:IAO_0000117>
    <rdfs:label xml:lang="en">ends with</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    <ns4:IAO_0000118>finished by</ns4:IAO_0000118>
    <ns4:IAO_0000233>add `Inverse Of`
issue https://github.com/OpenEnergyPlatform/ontology/issues/979
pull request https://github.com/OpenEnergyPlatform/ontology/pull/1086</ns4:IAO_0000233>
    <ns4:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
  </rdf:Description>
