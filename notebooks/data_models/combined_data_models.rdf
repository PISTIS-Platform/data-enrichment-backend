  <rdf:Description rdf:about="http://openenergy-platform.org/ontology/oeo/OEO_00010471">
    <ns4:IAO_0000118 xml:lang="en">non-energy consumption technology</ns4:IAO_0000118>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="N61d07c7485dc46f8adedc50f99da5e8e"/>
    <rdfs:subClassOf rdf:resource="http://openenergy-platform.org/ontology/oeo/OEO_00000407"/>
    <ns4:IAO_0000115 xml:lang="en">A non-energy use technology is a technology that describes among other things how to combine the consumption of energy carriers for non-energy use with other processes and artificial objects or other material entities in a specific way.</ns4:IAO_0000115>
