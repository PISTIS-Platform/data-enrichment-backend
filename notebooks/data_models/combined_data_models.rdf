  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000590">
    <ns4:IAO_0000119 xml:lang="en">https://github.com/information-artifact-ontology/IAO/issues/114</ns4:IAO_0000119>
    <ns4:IAO_0000232 xml:lang="en">The qualifier "written" is to set it apart from spoken names.  Also, note the restrictions to particulars.  We are not naming universals.   We could however, be naming, attributive collections which are particulars, so "All people located in the boundaries of the city of Little Rock, AR on June 18, 2011 at 9:50a CDT" would be a name.</ns4:IAO_0000232>
    <ns4:IAO_0000111 xml:lang="en">written name</ns4:IAO_0000111>
    <rdfs:isDefinedBy rdf:resource="http://openenergy-platform.org/ontology/oeo/imports/iao-extracted.owl"/>
    <ns4:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
    <ns4:IAO_0000115 xml:lang="en">A textual entity that denotes a particular in reality.</ns4:IAO_0000115>
    <rdfs:label xml:lang="en">written name</rdfs:label>
    <ns4:IAO_0000112 xml:lang="en">"Bill Clinton"</ns4:IAO_0000112>
    <ns4:IAO_0000112 xml:lang="en">"The Eiffel Tower"</ns4:IAO_0000112>
    <ns4:IAO_0000112 xml:lang="en">"United States of America"</ns4:IAO_0000112>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns4:IAO_0000117 xml:lang="en">PERSON: Bill Hogan</ns4:IAO_0000117>
