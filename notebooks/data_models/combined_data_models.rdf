  <rdf:Description rdf:about="http://w3id.org/um/cbcm/eu-cm-ontology#sourceCountry">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:seeAlso rdf:resource="http://w3id.org/um/cbcm/eu-cm-ontology#hasTransactionInput"/>
