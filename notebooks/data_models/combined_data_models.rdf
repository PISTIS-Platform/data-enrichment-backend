    <ns1:OEO_00110012>GrossNationalElectricityConsumption = GrossElectricityGeneration + ElectricityImports - ElectricityExports</ns1:OEO_00110012>
    <rdfs:label xml:lang="en">gross national electricity consumption value</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://openenergy-platform.org/ontology/oeo/OEO_00240019"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns4:IAO_0000233 xml:lang="en">issue: https://github.com/OpenEnergyPlatform/ontology/issues/916
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/997</ns4:IAO_0000233>
    <ns4:IAO_0000115 xml:lang="en">A gross national electricity consumption value is an energy consumption value measuring the consumption of electrical energy in a spatial region (e.g. a country), including gross electricity generation plus electricity imports, minus electricity exports. It is part of the gross inland energy consumption.</ns4:IAO_0000115>
    <owl:equivalentClass rdf:nodeID="Nb8224f5bba1a446493bf79cdb46c2555"/>
    <ns4:IAO_0000118>gross national electricity consumption</ns4:IAO_0000118>
  </rdf:Description>
