  <rdf:Description rdf:about="http://openenergy-platform.org/ontology/oeo/OEO_00010350">
    <ns4:IAO_0000233>issue: https://github.com/OpenEnergyPlatform/ontology/issues/1401
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1440

move to oeo-sector 
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1399
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1724</ns4:IAO_0000233>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://openenergy-platform.org/ontology/oeo/OEO_00000227"/>
    <ns1:OEO_00000504 rdf:resource="http://openenergy-platform.org/ontology/oeo/OEO_00000242"/>
    <ns4:IAO_0000119>2006 IPCC Guidelines for National Greenhouse Gas Inventories, Volume 1, Chapter 8.5, https://www.ipcc-nggip.iges.or.jp/public/2006gl/</ns4:IAO_0000119>
    <ns1:OEO_00010037>CRF 2.B.7</ns1:OEO_00010037>
    <ns4:IAO_0000115>The CRF sector (IPCC 2006) 'soda ash production' is an industry sector defined by the 2006 IPCC Guidelines for National Greenhouse Gas Inventories:
Soda ash (sodium carbonate, Na2CO3) is a white crystalline solid that is used as a raw material in a large number of industries including glass manufacture, soap and detergents, pulp and paper production and water treatment. Emissions of CO2 from the production of soda ash vary dependent on the manufacturing process. Four different processes may be used to produce soda ash. Three of these processes, monohydrate, sodium sesquicarbonate (trona) and direct carbonation, are referred to as natural processes. The fourth, the Solvay process, is classified as a synthetic process.</ns4:IAO_0000115>
    <rdfs:label xml:lang="en">CRF sector (IPCC 2006): soda ash production</rdfs:label>
    <ns4:BFO_0000050 rdf:resource="http://openenergy-platform.org/ontology/oeo/OEO_00010166"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UO_0000303">
    <ns3:hasExactSynonym>10^[-15]</ns3:hasExactSynonym>
    <ns3:hasExactSynonym>f</ns3:hasExactSynonym>
    <ns4:IAO_0000115>"A prefix in the metric system denoting a factor of 10 to the power of -15." [UO:GVG]</ns4:IAO_0000115>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000046"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/uo.owl"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
