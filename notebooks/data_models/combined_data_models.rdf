    <rdfs:label xml:lang="en">crude oil</rdfs:label>
    <ns4:IAO_0000118 xml:lang="de">Rohöl</ns4:IAO_0000118>
    <ns4:IAO_0000118 xml:lang="en">petroleum</ns4:IAO_0000118>
