  <rdf:Description rdf:nodeID="N929e95d6882b4838851806e831d99462">
    <owl:annotatedTarget xml:lang="en">The qualifier "written" is to set it apart from spoken names.  Also, note the restrictions to particulars.  We are not naming universals.   We could however, be naming, attributive collections which are particulars, so "All people located in the boundaries of the city of Little Rock, AR on June 18, 2011 at 9:50a CDT" would be a name.</owl:annotatedTarget>
    <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/IAO_0000590"/>
