    <rdfs:subClassOf rdf:resource="https://w3id.org/airm-o/ontology#ObjectWithSchedule"/>
    <rdfs:comment>Information about the operational status of the manoeuvring area elements.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://openenergy-platform.org/ontology/oeo/OEO_00280001">
    <ns4:IAO_0000233>issue: https://github.com/OpenEnergyPlatform/ontology/issues/1145
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1326

Add DisjointWith axiom:
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1410</ns4:IAO_0000233>
    <rdfs:label xml:lang="en">text file format</rdfs:label>
    <ns4:IAO_0000115>A text file format is a file format that is structured as a sequence of lines of electronic text.</ns4:IAO_0000115>
    <owl:disjointWith rdf:resource="http://openenergy-platform.org/ontology/oeo/OEO_00280004"/>
    <rdfs:subClassOf rdf:resource="http://openenergy-platform.org/ontology/oeo/OEO_00280000"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
