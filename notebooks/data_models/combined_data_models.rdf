  </rdf:Description>
  <rdf:Description rdf:about="http://openenergy-platform.org/ontology/oeo/OEO_00020364">
    <ns4:IAO_0000233>issue: https://github.com/OpenEnergyPlatform/ontology/issues/1572
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1728</ns4:IAO_0000233>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://openenergy-platform.org/ontology/oeo/OEO_00000159"/>
    <rdfs:comment>The kinetic energy storage object is being charged with kinetic energy and releases kinetic energy during the decharging process. The stored energy within the object may appear in a different form of energy, though.</rdfs:comment>
    <rdfs:label xml:lang="en">kinetic energy storage object</rdfs:label>
    <ns4:IAO_0000115>A kinetic energy storage object is an energy storage object that has the function to store kinetic energy.</ns4:IAO_0000115>
    <owl:equivalentClass rdf:nodeID="N1fc24ab680084ff9a551d1af2e5bb7cb"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na11e143c3d184b23b21aeb69d90a16ed">
    <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
    <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ro/releases/2023-02-22/ro.owl"/>
    <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000116"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedTarget xml:lang="en">Has_participant is a primitive instance-level relation between a process, a continuant, and a time at which the continuant participates in some way in the process. The relation obtains, for example, when this particular process of oxygen exchange across this particular alveolar membrane has_participant this particular sample of hemoglobin at this particular time.</owl:annotatedTarget>
  </rdf:Description>
