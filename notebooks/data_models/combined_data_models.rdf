  <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/icity/Trip/Trip">
    <rdfs:subClassOf rdf:nodeID="Nab52bf9fccc649149401266ef6b23b09"/>
    <rdfs:subClassOf rdf:nodeID="N23839b56db4e447fb9c3a7379eed805c"/>
