    <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/Activity/Activity"/>
    <rdfs:subClassOf rdf:nodeID="Nbb30f30449d7418ab41bf1e4ba8454f0"/>
    <rdfs:subClassOf rdf:nodeID="N108a5c96ec5a410192b5a31db8dab5a0"/>
    <rdfs:subClassOf rdf:nodeID="Ne847b62bdf564fa5b1a037a7d27352cf"/>
    <rdfs:subClassOf rdf:nodeID="N5ed376fb870840e989679fe41d1bd3c9"/>
    <rdfs:subClassOf rdf:nodeID="N02f4009f80dd42f5a24c7c7ed9f698ab"/>
    <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/icity/Trip/TripOntologyThing"/>
    <rdfs:subClassOf rdf:nodeID="N6e831ce1bcbb4626958b99e9e51b2f51"/>
    <rdfs:subClassOf rdf:nodeID="Ne29f073615a54225a8f7d9ee886038c8"/>
    <rdfs:subClassOf rdf:nodeID="N5a027ad17e524be68b6e5b35fbdff7d9"/>
    <dc:description>A Trip describes movement of a Persons from one location to another via some Mode(s).
A Trip is made by a Person to facilitate participation in some Activity.
A Trip starts at some Location and ends at some Location.
A Trip occurs during some Interval.
A Trip occurs in some Network(s).
A Trip occurs via some Arc(s).
A Trip occurs on some Transportation Complex. (e.g. a road or a rail)
A Trip contains some Trip Segments.
A Trip may incur some cost (monetary or otherwise).</dc:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
