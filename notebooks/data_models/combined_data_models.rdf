    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/ENVO_2000020"/>
    <ns4:IAO_0000118 xml:lang="de">elektrische Energie</ns4:IAO_0000118>
    <ns4:IAO_0000118>electricity</ns4:IAO_0000118>
    <ns4:IAO_0000118 xml:lang="de">Elektroenergie</ns4:IAO_0000118>
    <ns4:IAO_0000115 xml:lang="en">Electrical energy is a form of energy derived from the potential or kinetic energy of charged particles.</ns4:IAO_0000115>
    <ns4:IAO_0000119 xml:lang="en">https://en.wikipedia.org/wiki/Electrical_energy</ns4:IAO_0000119>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
