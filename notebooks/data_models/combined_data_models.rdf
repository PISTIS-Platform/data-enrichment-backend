  <rdf:Description rdf:about="http://ontology.eil.utoronto.ca/icity/UrbanSystem/">
    <owl:imports rdf:resource="http://ontology.eil.utoronto.ca/icity/Vehicle/1.2/"/>
    <owl:imports rdf:resource="http://ontology.eil.utoronto.ca/icity/Trip/1.2/"/>
    <owl:imports rdf:resource="http://ontology.eil.utoronto.ca/icity/PublicTransit/1.2/"/>
    <owl:imports rdf:resource="http://ontology.eil.utoronto.ca/icity/TransportationSystem/1.2/"/>
    <owl:imports rdf:resource="http://ontology.eil.utoronto.ca/icity/Person/1.2/"/>
    <owl:imports rdf:resource="http://ontology.eil.utoronto.ca/icity/Parking/1.2/"/>
    <owl:imports rdf:resource="http://ontology.eil.utoronto.ca/icity/Organization/1.2/"/>
