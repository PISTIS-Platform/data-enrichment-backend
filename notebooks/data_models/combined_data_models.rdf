  <rdf:Description rdf:about="http://w3id.org/um/cbcm/eu-cm-ontology#hasMergingCompany">
    <rdfs:label xml:lang="en">has merging company</rdfs:label>
    <rdfs:comment xml:lang="en">(hasMergingCompany ?ENTITY1 ?ENTITY2) means that some company merger transaction ?ENTITY1 involves a company ?ENTITY2 which will be dissolved during the process of ?ENTITY1 and will be acquired (via a universal transfer of assets and liabilities) by another distinct company involved in ?ENTITY1.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://w3id.org/um/cbcm/eu-cm-ontology#AcquiringCompany"/>
    <rdfs:seeAlso rdf:resource="http://w3id.org/um/cbcm/eu-cm-ontology#CompanyMerger"/>
    <rdfs:seeAlso rdf:resource="http://w3id.org/um/cbcm/eu-cm-ontology#MergingCompany"/>
    <rdfs:range rdf:resource="http://w3id.org/um/cbcm/eu-cm-ontology#Company"/>
    <ns9:example>(hasMergingCompany crossBorderMerger1 company1)</ns9:example>
    <rdfs:subPropertyOf rdf:resource="http://w3id.org/um/cbcm/eu-cm-ontology#hasTransactionInput"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://w3id.org/um/cbcm/eu-cm-ontology#CompanyMerger"/>
  </rdf:Description>
