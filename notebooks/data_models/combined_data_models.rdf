  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000063">
    <ns4:IAO_0000115 xml:lang="en">x precedes y if and only if the time point at which x ends is before or equivalent to the time point at which y starts. Formally: x precedes y iff ω(x) &lt;= α(y), where α is a function that maps a process to a start point, and ω is a function that maps a process to an end point.</ns4:IAO_0000115>
    <rdfs:label xml:lang="en">precedes</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002222"/>
    <ns4:IAO_0000111 xml:lang="en">precedes</ns4:IAO_0000111>
  </rdf:Description>
