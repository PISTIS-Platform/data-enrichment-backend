    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">EU allowance</rdfs:label>
    <ns4:IAO_0000233>issue https://github.com/OpenEnergyPlatform/ontology/issues/677
pull request https://github.com/OpenEnergyPlatform/ontology/pull/740</ns4:IAO_0000233>
    <ns4:IAO_0000118 xml:lang="en">EUA</ns4:IAO_0000118>
    <ns4:IAO_0000118 xml:lang="de">EU-Klimazertifikat</ns4:IAO_0000118>
    <ns4:IAO_0000118 xml:lang="de">EU-Berechtigung</ns4:IAO_0000118>
    <ns4:IAO_0000115>An EU Allowance (EUA) is an emission certificate used in the European Union Emissions Trading System (EU ETS). It permits the emission of a CO2 equivalent quantity of 1 tonne.</ns4:IAO_0000115>
  </rdf:Description>
