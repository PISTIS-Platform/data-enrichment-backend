  <rdf:Description rdf:about="http://w3id.org/um/cbcm/eu-cm-ontology#CrossBorderMergerIntoNewCompany">
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/um/cbcm/eu-cm-ontology#"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Article 90: the operation whereby several companies are wound up without going into liquidation and transfer to a company that they set up all their assets and liabilities in exchange for the issue to their shareholders of shares in the new company and a cash payment, if any, not exceeding 10 % of the nominal value of the shares so issued or, where they have no nominal value, of their accounting par value. Companies involved come from two or more distinct countries.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://w3id.org/um/cbcm/eu-cm-ontology#CrossBorderMerger"/>
    <rdfs:label xml:lang="en">Cross-border merger into a new company</rdfs:label>
  </rdf:Description>
