    <ns4:BFO_0000180>Site</ns4:BFO_0000180>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo.owl"/>
    <ns4:BFO_0000179>site</ns4:BFO_0000179>
    <ns4:IAO_0000600 xml:lang="en">b is a site means: b is a three-dimensional immaterial entity that is (partially or wholly) bounded by a material entity or it is a three-dimensional immaterial part thereof. (axiom label in BFO2 Reference: [034-002])</ns4:IAO_0000600>
    <ns4:IAO_0000602>(forall (x) (if (Site x) (ImmaterialEntity x))) // axiom label in BFO2 CLIF: [034-002] </ns4:IAO_0000602>
  </rdf:Description>
