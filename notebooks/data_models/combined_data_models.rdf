    <rdfs:range rdf:resource="https://w3id.org/airm-o/ontology#CodeRunwaySectionType"/>
    <rdfs:comment>Indicates the part of the runway that is affected. This supports indicating the contamination information on each third of the runway length, starting from the threshold of the runway direction having the lower designation number.</rdfs:comment>
  </rdf:Description>
