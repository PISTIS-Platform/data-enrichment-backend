  <rdf:Description rdf:nodeID="N6b86d0b33d7945bf84fc417bfb61f4a7">
    <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
    <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000116"/>
    <owl:annotatedTarget xml:lang="en">Occurrents are not subject to change and so parthood between occurrents holds for all the times that the part exists. Many continuants are subject to change, so parthood between continuants will only hold at certain times, but this is difficult to specify in OWL. See http://purl.obolibrary.org/obo/ro/docs/temporal-semantics/</owl:annotatedTarget>
    <prov:wasDerivedFrom rdf:resource="http://openenergy-platform.org/ontology/oeo/releases/2.4.0/imports/iao-extracted.owl"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/um/cbcm/eu-cm-ontology#BoardLevelEmployeeRepresentationRight">
    <rdfs:seeAlso rdf:resource="http://data.europa.eu/eli/dir/2017/1132/oj"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Board-level employee representation right</rdfs:label>
    <rdfs:comment xml:lang="en">Board-level representation of employees (BLER) refers to the phenomenon where employees or their representatives elect or appoint representatives to the strategic decision-making body of a company (i.e. the supervisory board or non-executive board in a one-tier system). The BLER right requires that if such a system of BLER exists prior to a cross-border company transaction, such a right must be upheld in the acquiring/recipient company under the "before-and-after-principle".</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://w3id.org/um/cbcm/eu-cm-ontology#"/>
    <rdfs:subClassOf rdf:resource="http://w3id.org/um/cbcm/eu-cm-ontology#SocialRight"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2bb0e2124c8440c78ddfdee28f02b4d5">
    <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
    <owl:annotatedTarget rdf:resource="http://ontologydesignpatterns.org/wiki/Submissions:PartOf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <prov:wasDerivedFrom rdf:resource="http://purl.obolibrary.org/obo/ro/releases/2023-02-22/ro.owl"/>
    <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
  </rdf:Description>
