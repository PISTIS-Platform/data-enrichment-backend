  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000148">
    <ns4:IAO_0000112 xml:lang="en">the moment at which a child is born</ns4:IAO_0000112>
    <ns4:IAO_0000112 xml:lang="en">a temporal region that is occupied by a process boundary</ns4:IAO_0000112>
    <ns4:IAO_0000112 xml:lang="en">right now</ns4:IAO_0000112>
    <ns4:IAO_0000112 xml:lang="en">the moment of death.</ns4:IAO_0000112>
    <ns4:IAO_0000112 xml:lang="en">the moment at which a finger is detached in an industrial accident</ns4:IAO_0000112>
    <ns4:BFO_0000180>ZeroDimensionalTemporalRegion</ns4:BFO_0000180>
    <ns4:IAO_0000600 xml:lang="en">A zero-dimensional temporal region is a temporal region that is without extent. (axiom label in BFO2 Reference: [102-001])</ns4:IAO_0000600>
    <ns4:IAO_0000118 xml:lang="en">temporal instant.</ns4:IAO_0000118>
    <ns4:BFO_0000179>0d-t-region</ns4:BFO_0000179>
    <rdfs:label xml:lang="en">zero-dimensional temporal region</rdfs:label>
    <ns4:IAO_0000602>(forall (x) (if (ZeroDimensionalTemporalRegion x) (TemporalRegion x))) // axiom label in BFO2 CLIF: [102-001] </ns4:IAO_0000602>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo.owl"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000008"/>
  </rdf:Description>
