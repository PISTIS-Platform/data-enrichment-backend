  <rdf:Description rdf:about="http://openenergy-platform.org/ontology/oeo/OEO_00010124">
    <ns4:IAO_0000233>issue: https://github.com/OpenEnergyPlatform/ontology/issues/834
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/857</ns4:IAO_0000233>
    <ns4:IAO_0000118>ESD</ns4:IAO_0000118>
    <ns4:IAO_0000118 xml:lang="de">Lastenteilungsentscheidung</ns4:IAO_0000118>
    <rdfs:label xml:lang="en">Effort Sharing Decision</rdfs:label>
    <ns4:BFO_0000050 rdf:resource="http://openenergy-platform.org/ontology/oeo/OEO_00010129"/>
    <ns4:IAO_0000115>The Effort Sharing Decision (ESD) is the European effort sharing for the years 2013-2020. It covers the European Union, Norway, Iceland and Liechtenstein and the following greenhouse gases: carbon dioxide, methane, nitrous oxide, hydrofluorocarbons, perfluorocarbons and sulphur hexafluoride. Emission quantities under the ESD are calculated using global warming potentials from the Fourth IPCC Assessment Report.</ns4:IAO_0000115>
    <rdf:type rdf:nodeID="N5f80a5f4b0db47a89a50c99198cec936"/>
    <rdf:type rdf:resource="http://openenergy-platform.org/ontology/oeo/OEO_00010123"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  </rdf:Description>
