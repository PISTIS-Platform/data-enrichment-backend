    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <ns9:example>(hasTransactionInput crossBorderMerger1 company1)</ns9:example>
    <rdfs:subPropertyOf rdf:resource="http://w3id.org/um/cbcm/eu-cm-ontology#cbcmTransactionRelation"/>
