    <rdfs:subClassOf rdf:resource="http://openenergy-platform.org/ontology/oeo/OEO_00000061"/>
    <ns4:IAO_0000116>Reservoirs created by dams provide water for activities such as hydro energy transformation, irrigation, human consumption, industrial use, aquaculture, and navigability. They are also used to regulate floods.</ns4:IAO_0000116>
  </rdf:Description>
