  <rdf:Description rdf:about="http://openenergy-platform.org/ontology/oeo/OEO_00010068">
    <ns4:IAO_0000119>Bundes-Klimaschutzgesetz (KSG), Anlage 1 (zu den §§ 4 und 5) https://www.gesetze-im-internet.de/ksg/anlage_1.html</ns4:IAO_0000119>
    <ns4:BFO_0000051 rdf:resource="http://openenergy-platform.org/ontology/oeo/OEO_00010062"/>
    <ns4:BFO_0000051 rdf:resource="http://openenergy-platform.org/ontology/oeo/OEO_00010059"/>
